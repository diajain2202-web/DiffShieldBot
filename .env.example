# GitHub App Credentials
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_PATH=./diffshield.private-key.pem
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Runtime Configuration
DIFFSHIELD_DRY_RUN=0
DIFFSHIELD_DB_PATH=diffshield.db
DIFFSHIELD_HOLD_HOURS=12
DIFFSHIELD_HOST=0.0.0.0
DIFFSHIELD_PORT=8000

# Optional Local Embedder (hashed [default, zero-dep] or st [sentence-transformers])
DIFFSHIELD_EMBEDDER=hashed

